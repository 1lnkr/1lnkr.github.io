# Copy to .env for local overrides. Only PUBLIC_* values are used, and none of them are secrets.

# Full origin of the deployed site (no trailing slash).
# PUBLIC_SITE_URL=https://lnkrs.github.io

# Base path: "/" for lnkrs.github.io (a user/organisation site) or a custom domain.
# PUBLIC_BASE_PATH=/

# GitHub repository Decap CMS commits to ("owner/repo"). In GitHub Actions this
# falls back to GITHUB_REPOSITORY automatically.
# PUBLIC_CMS_REPO=Lnkrs/Lnkrs.github.io

# Decap OAuth proxy (Vercel, github.com/dev-bishal/decap-oauth). Not a secret.
# PUBLIC_CMS_OAUTH_URL=https://decap-oauth-bishal.vercel.app
# PUBLIC_CMS_OAUTH_ENDPOINT=api/auth
