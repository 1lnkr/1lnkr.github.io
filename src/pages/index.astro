---
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkRow from '../components/dashboard/LinkRow.astro';
import { getLinks, REDIRECT_LABELS, sortCategories } from '../lib/links';
import { settings, url } from '../lib/site';

/*
 * Administrator dashboard. It is a static page built from the CMS content — the numbers
 * are link counts, not visitor analytics. Drafts and links with "Show on homepage" off
 * appear only in `npm run dev`, so their destinations are never in the deployed homepage.
 */
const all = await getLinks({ includeDrafts: true });
const published = all.filter((link) => link.published);
const showDrafts = import.meta.env.DEV;
const listed = showDrafts ? all : published.filter((link) => link.showOnHomepage);
const hiddenCount = published.filter((link) => !link.showOnHomepage).length;

const count = (type: string) => published.filter((link) => link.effectiveType === type).length;
const stats = [
  { label: 'Total links', value: all.length, hint: 'Including drafts' },
  { label: 'Published', value: published.length, hint: 'Live pages' },
  { label: REDIRECT_LABELS.direct, value: count('direct'), hint: 'Published', kind: 'direct' },
  { label: REDIRECT_LABELS.locker, value: count('locker'), hint: 'Published', kind: 'locker' },
  { label: REDIRECT_LABELS.timer, value: count('timer'), hint: 'Published', kind: 'timer' },
];
const categories = sortCategories(listed.map((link) => link.category));
---

<BaseLayout
  title={`${settings.siteName} — Link dashboard`}
  description={settings.siteDescription || `${settings.siteName}: personal short links.`}
  robots={settings.indexHomepage ? 'index, follow' : 'noindex, follow'}
>
  <a slot="header-actions" class="btn" href={url('/admin/')}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
      ><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg
    >
    <span class="hide-sm">Open CMS</span>
  </a>

  <div class="page-head">
    <div>
      <h1>Link dashboard</h1>
      <p class="muted">
        Overview of every short link. Create and edit links in the <a href={url('/admin/')}>CMS</a> — each change is committed to GitHub
        and the site rebuilds automatically.
      </p>
    </div>
    <a class="btn btn-primary" href={url('/admin/#/collections/links/new')}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"
        ><path d="M12 5v14M5 12h14"></path></svg
      >
      New link
    </a>
  </div>

  <section aria-label="Link counts" class="stats">
    {
      stats.map((stat) => (
        <div class="card stat">
          <p class="stat__label">
            {stat.kind && <span class={`dot dot-${stat.kind}`} aria-hidden="true" />}
            {stat.label}
          </p>
          <p class="stat__value">{stat.value}</p>
          <p class="stat__hint">{stat.hint}</p>
        </div>
      ))
    }
  </section>
  <p class="note">These are link counts from the site's content, not visitor statistics — a static site cannot record visits.</p>

  <section aria-labelledby="links-heading" class="links">
    <div class="links__head">
      <h2 id="links-heading">Recent links</h2>
      {
        listed.length > 0 && (
          <div class="filters" role="search">
            <label class="visually-hidden" for="filter-text">
              Search links
            </label>
            <input id="filter-text" class="input" type="search" placeholder="Search title, slug or destination" data-filter-text autocomplete="off" />
            <label class="visually-hidden" for="filter-type">
              Redirect type
            </label>
            <select id="filter-type" class="input" data-filter-type>
              <option value="">All types</option>
              <option value="direct">{REDIRECT_LABELS.direct}</option>
              <option value="locker">{REDIRECT_LABELS.locker}</option>
              <option value="timer">{REDIRECT_LABELS.timer}</option>
            </select>
            {categories.length > 1 && (
              <>
                <label class="visually-hidden" for="filter-category">
                  Category
                </label>
                <select id="filter-category" class="input" data-filter-category>
                  <option value="">All categories</option>
                  {categories.map((c) => (
                    <option value={c}>{c}</option>
                  ))}
                </select>
              </>
            )}
          </div>
        )
      }
    </div>

    {
      showDrafts && (all.length !== published.length || hiddenCount > 0) && (
        <p class="note">Dev mode: drafts and links hidden from the homepage are shown here. Drafts are never built; hidden links work but aren't listed on the deployed homepage.</p>
      )
    }
    {!showDrafts && hiddenCount > 0 && (
      <p class="note">
        {hiddenCount} published link{hiddenCount === 1 ? ' is' : 's are'} not listed here. Manage {hiddenCount === 1 ? 'it' : 'them'} in the <a href={url('/admin/#/collections/links')}>CMS</a>.
      </p>
    )}

    {
      listed.length === 0 ? (
        <div class="card empty">
          <h3>No links yet</h3>
          <p class="muted">Create your first short link in the CMS.</p>
          <a class="btn btn-primary" href={url('/admin/#/collections/links/new')}>
            Create a link
          </a>
        </div>
      ) : (
        <ul class="link-list" data-link-list>
          {listed.map((link) => (
            <LinkRow link={link} />
          ))}
        </ul>
      )
    }
    <p class="note" data-empty-filter hidden>No links match your filters.</p>
  </section>

  <p class="toast" role="status" aria-live="polite" data-toast></p>
</BaseLayout>

<style>
  .page-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 1.5rem;
  }
  .page-head p {
    max-width: 60ch;
    margin: 0;
  }
  .muted {
    color: var(--text-muted);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 0.75rem;
  }
  .stat {
    padding: 1rem 1.1rem;
    box-shadow: var(--shadow-sm);
  }
  .stat p {
    margin: 0;
  }
  .stat__label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-muted);
  }
  .stat__value {
    font-size: 1.85rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
  }
  .stat__hint {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .dot-direct {
    background: var(--accent);
  }
  .dot-locker {
    background: var(--warning);
  }
  .dot-timer {
    background: var(--success);
  }
  .note {
    margin: 0.75rem 0 0;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .links {
    margin-top: 2.5rem;
  }
  .links__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-bottom: 1rem;
  }
  .links__head h2 {
    margin: 0;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    flex: 1 1 420px;
    justify-content: flex-end;
  }
  .input {
    min-height: 40px;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 0.9375rem;
  }
  .filters input {
    flex: 1 1 220px;
    min-width: 0;
  }
  .filters select {
    flex: 0 1 auto;
  }
  .link-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .empty {
    padding: 2.5rem 1.5rem;
    text-align: center;
  }
  .toast {
    position: fixed;
    left: 50%;
    bottom: 1.25rem;
    transform: translate(-50%, 1rem);
    margin: 0;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--text);
    color: var(--bg);
    font-size: 0.875rem;
    font-weight: 600;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.2s var(--ease),
      transform 0.2s var(--ease);
  }
  .toast.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  @media (max-width: 560px) {
    .hide-sm {
      display: none;
    }
    .page-head .btn {
      width: 100%;
    }
    .filters select {
      flex: 1 1 140px;
    }
  }
</style>

<script>
  import { initDashboard } from '../scripts/dashboard';
  initDashboard();
</script>
