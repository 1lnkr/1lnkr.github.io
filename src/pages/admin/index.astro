---
import { settings, url } from '../../lib/site';

/*
 * Decap CMS entry point (/admin/). Hiding this URL is NOT the protection: every save is
 * a commit made with the editor's own GitHub token, so only people with write access to
 * the repository can change anything. The configuration is generated by ./config.yml.ts.
 */
const DECAP_VERSION = '3.17.3';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="same-origin" />
    <title>Content Manager · {settings.siteName}</title>
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link href={url('/admin/config.yml')} type="text/yaml" rel="cms-config-url" />
  </head>
  <body>
    <script is:inline src={`https://unpkg.com/decap-cms@${DECAP_VERSION}/dist/decap-cms.js`}></script>
  </body>
</html>
