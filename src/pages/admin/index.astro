---
import { absoluteUrl, LINK_PREFIX, settings, url } from '../../lib/site';
import { jsonForScript, SLUG_MAX_LENGTH } from '../../lib/validate';

/*
 * Decap CMS entry point (/admin/). Hiding this URL is NOT the protection: every save is
 * a commit made with the editor's own GitHub token, so only people with write access to
 * the repository can change anything. The configuration is generated by ./config.yml.ts.
 *
 * The inline script registers a preview for the Links collection that shows the live
 * short URL (custom slug, or the automatic one) with open/copy buttons.
 */
const DECAP_VERSION = '3.17.3';
const previewConfig = jsonForScript({
  linkBase: absoluteUrl(LINK_PREFIX ? `/${LINK_PREFIX}/` : '/'),
  slugMax: SLUG_MAX_LENGTH,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="same-origin" />
    <title>Content Manager · {settings.siteName}</title>
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link href={url('/admin/config.yml')} type="text/yaml" rel="cms-config-url" />
  </head>
  <body>
    <script is:inline src={`https://unpkg.com/decap-cms@${DECAP_VERSION}/dist/decap-cms.js`}></script>
    <script is:inline set:html={`window.__LINK_PREVIEW__ = ${previewConfig};`} />
    <script is:inline>
      (function () {
        if (!window.CMS || !window.createClass || !window.h) return;
        var cfg = window.__LINK_PREVIEW__;
        var h = window.h;

        // Same rules as slugify() in src/lib/validate.ts.
        function slugify(value) {
          return String(value || '')
            .normalize('NFKD')
            .replace(new RegExp('[' + String.fromCharCode(0x300) + '-' + String.fromCharCode(0x36f) + ']', 'g'), '')
            .toLowerCase()
            .replace(/&/g, ' and ')
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '')
            .slice(0, cfg.slugMax)
            .replace(/-+$/g, '');
        }

        var box = { fontFamily: 'system-ui, -apple-system, Segoe UI, Roboto, sans-serif', color: '#15181e', padding: '24px', lineHeight: 1.5 };
        var card = { border: '1px solid #e2e5ea', borderRadius: '12px', padding: '16px 18px', marginBottom: '16px', background: '#fff' };
        var label = { fontSize: '12px', fontWeight: 700, letterSpacing: '.06em', textTransform: 'uppercase', color: '#5a6270', margin: '0 0 6px' };
        var urlStyle = { fontFamily: 'ui-monospace, Consolas, monospace', fontSize: '15px', wordBreak: 'break-all', color: '#3451d1' };
        var btn = { display: 'inline-block', marginTop: '12px', marginRight: '8px', padding: '7px 12px', borderRadius: '8px', border: '1px solid #cfd4dc', background: '#fff', color: '#15181e', font: 'inherit', fontSize: '14px', fontWeight: 600, cursor: 'pointer', textDecoration: 'none' };
        var note = { fontSize: '13px', color: '#5a6270', margin: '8px 0 0' };
        var types = { direct: 'Direct Redirect', locker: 'URL Locker', timer: 'Timed Redirect' };

        var LinkPreview = window.createClass({
          getInitialState: function () {
            return { copied: false };
          },
          copy: function (text) {
            var self = this;
            var done = function () {
              self.setState({ copied: true });
              setTimeout(function () { self.setState({ copied: false }); }, 1500);
            };
            try {
              navigator.clipboard.writeText(text).then(done, function () {});
            } catch (e) {}
          },
          render: function () {
            var entry = this.props.entry;
            var data = entry.get('data');
            var custom = String(data.get('slug') || '').trim().toLowerCase();
            var isNew = !!entry.get('newRecord');
            var fileSlug = entry.get('slug');
            var auto = isNew || !fileSlug ? slugify(data.get('title')) : slugify(fileSlug);
            var slug = custom || auto;
            var shortUrl = slug ? cfg.linkBase + slug + '/' : '';
            var published = data.get('published') !== false;
            var listed = data.get('showOnHomepage') !== false;
            var destination = String(data.get('destination') || '');
            var type = types[data.get('redirectType')] || types.direct;
            var image = data.get('image') ? this.props.getAsset(data.get('image')) : null;

            var status;
            if (!slug) status = 'Enter a title (or a custom slug) to see the short URL.';
            else if (!published) status = 'Not live: "Published" is off, so this link is not built.';
            else if (isNew) status = 'Live about 1–2 minutes after you publish (the site rebuilds on each save).';
            else status = 'Changes go live about 1–2 minutes after you save.';

            return h('div', { style: box },
              h('div', { style: card },
                h('p', { style: label }, 'Short URL' + (custom ? ' · custom slug' : ' · automatic slug')),
                shortUrl
                  ? h('a', { href: shortUrl, target: '_blank', rel: 'noopener', style: urlStyle }, shortUrl)
                  : h('span', { style: note }, '—'),
                shortUrl && published && h('div', null,
                  h('a', { href: shortUrl, target: '_blank', rel: 'noopener', style: btn }, 'Open short URL ↗'),
                  h('button', { type: 'button', style: btn, onClick: this.copy.bind(this, shortUrl) }, this.state.copied ? 'Copied!' : 'Copy short URL')
                ),
                h('p', { style: note }, status),
                !custom && slug && !isNew && slugify(data.get('title')) !== auto &&
                  h('p', { style: note }, 'The automatic slug was fixed when this link was created, so it does not follow later title changes.')
              ),
              h('div', { style: card },
                h('p', { style: label }, 'Details'),
                h('p', { style: { margin: '0 0 4px' } }, h('strong', null, data.get('title') || 'Untitled')),
                h('p', { style: { margin: '0 0 4px', fontSize: '14px' } }, type + (published ? '' : ' · Draft') + (listed ? '' : ' · Hidden from homepage')),
                destination && h('p', { style: { margin: 0, fontSize: '14px', wordBreak: 'break-all' } }, 'Destination: ', h('span', { style: { fontFamily: 'ui-monospace, Consolas, monospace' } }, destination))
              ),
              image && h('img', { src: image.toString(), alt: '', style: { width: '100%', maxWidth: '600px', borderRadius: '12px', border: '1px solid #e2e5ea' } })
            );
          }
        });

        window.CMS.registerPreviewTemplate('links', LinkPreview);
      })();
    </script>
  </body>
</html>
