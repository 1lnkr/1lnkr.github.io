---
import type { ResolvedLink } from '../../lib/links';
import { imageSrc } from '../../lib/site';

interface Props {
  link: ResolvedLink;
}

const { link } = Astro.props;
---

<header class="hero">
  {
    link.image && (
      <img
        class="hero__image"
        src={imageSrc(link.image)}
        alt={link.imageAlt}
        width="1200"
        height="630"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    )
  }
  <div class="hero__body">
    {!link.uncategorised && <p class="hero__eyebrow">{link.category}</p>}
    <h1>{link.title}</h1>
    {link.shortDescription && <p class="hero__lead">{link.shortDescription}</p>}
    <p class="hero__destination">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
        ><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path></svg
      >
      <span>Destination: <strong>{link.destinationHost}</strong></span>
    </p>
  </div>
</header>

<style>
  .hero__image {
    width: 100%;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
    border-radius: var(--radius) var(--radius) 0 0;
  }
  .hero__body {
    padding: 1.5rem 1.5rem 0;
  }
  .hero__eyebrow {
    margin: 0 0 0.35rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .hero__lead {
    color: var(--text-muted);
    font-size: 1.0625rem;
  }
  .hero__destination {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    font-size: 0.875rem;
    color: var(--text-muted);
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .hero__destination svg {
    width: 15px;
    height: 15px;
    flex: none;
  }
  @media (max-width: 480px) {
    .hero__body {
      padding: 1.15rem 1.15rem 0;
    }
  }
</style>
